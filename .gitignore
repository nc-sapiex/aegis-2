# OS files
.DS_Store
Thumbs.db

# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example

# On-prem installer drops the customer's license here (scripts/aegis-install.sh)
/license.aegis
# On-prem backup mount default target (docker-compose.onprem.yml's BACKUP_HOST_PATH)
/backups/
# Throwaway keypair from `pnpm drill:license` (scripts/drills/generate-drill-license.sh)
# — the public key and issued license ARE meant to be committed, the private
# key never is.
/drills/fixtures/drill-key.private.pem

