{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read --strict",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-reference-guard.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm tsc *)",
      "Bash(pnpm test:unit *)",
      "Bash(git fetch *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm vitest *)",
      "mcp__honcho__inspect_workspace",
      "Bash(gh run watch *)",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__honcho__list_conclusions",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__honcho__get_metadata",
      "mcp__honcho__inspect_session"
    ]
  }
}
