# =============================================================================
# AEGIS Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# All secrets use CHANGE_ME_* placeholders — replace before any deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=aegis
POSTGRES_PORT=5433

# Connection strings (used by Prisma / app)
# With docker-compose.yml + docker-compose.dev.yml, the port is published on the
# host, so use "localhost" and 5433. Inside the compose network it is "postgres":5432.
# App connects as aegis_app (created by pnpm db:bootstrap, no SUPERUSER, no BYPASSRLS)
DATABASE_URL=postgresql://aegis_app:CHANGE_ME_APP_PASSWORD@localhost:5433/aegis
DATABASE_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
# Owner connection used only by db:push, db:bootstrap, db:verify, db:seed
DATABASE_OWNER_URL=postgresql://aegis:CHANGE_ME_IN_PRODUCTION@localhost:5433/aegis
# BYPASSRLS connection for the small set of cross-tenant/pre-auth reads (prismaSystem)
DATABASE_SYSTEM_URL=postgresql://aegis_system:CHANGE_ME_SYSTEM_PASSWORD@localhost:5433/aegis
DATABASE_SYSTEM_PASSWORD=CHANGE_ME_SYSTEM_PASSWORD
# Production: append ?sslmode=require for encrypted DB connections (DSEC-02)
# Example: postgresql://aegis:password@localhost:5433/aegis?sslmode=require

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Object storage — s3 (AWS), minio (on-prem), or disabled
# -----------------------------------------------------------------------------
# STORAGE_DRIVER=s3 uses AWS credentials below directly. STORAGE_DRIVER=minio
# points the same AWS SDK at the on-prem MinIO container below — the SDK's
# default credential chain reads AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, so
# on-prem installs set those to the same values as MINIO_ROOT_USER/PASSWORD.
STORAGE_DRIVER=s3
# Required only when STORAGE_DRIVER=minio. Inside the compose network the
# minio service is reachable at http://minio:9000.
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# AWS S3 Evidence Storage (Mumbai region — RBI data localization)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
S3_BUCKET_NAME=aegis-evidence-dev

# -----------------------------------------------------------------------------
# MinIO (on-prem object storage — docker-compose.yml's minio/createbuckets
# services; only started with the app/full-stack profile, see docker-compose.dev.yml)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# AWS SES Email (Mumbai region — RBI data localization)
# -----------------------------------------------------------------------------
# Domain aegis.in must be verified in SES console with DKIM, SPF, and DMARC DNS records.
# Request SES production access to send to non-verified addresses.
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@aegis.in

# -----------------------------------------------------------------------------
# Mail driver — ses (AWS), smtp (on-prem relay or MailHog), or disabled
# -----------------------------------------------------------------------------
MAIL_DRIVER=ses
# Required (all four, non-empty) when MAIL_DRIVER=smtp — the mailer throws
# otherwise. For the MailHog install drill: SMTP_HOST=mailhog, SMTP_PORT=1025,
# SMTP_USER/SMTP_PASSWORD can be any non-empty dummy value (MailHog accepts
# any SMTP AUTH). For a real on-prem install, point these at the bank's own
# SMTP relay instead of MailHog.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# MailHog (on-prem install drill only — see docker-compose.onprem.yml)
# -----------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# -----------------------------------------------------------------------------
# License file (on-prem installs only — unset means no license check at boot)
# -----------------------------------------------------------------------------
# aegis-install.sh copies the license file to ./license.aegis on the host;
# docker-compose.onprem.yml mounts it read-only to /app/license.aegis inside
# the app container, so this path must match that mount, not the host path.
LICENSE_FILE_PATH=/app/license.aegis
# The public key Sapiex provides with your license (PEM). Each deployment's
# keypair is whatever scripts/aegis-license.ts generated for that install —
# there is no single fixed value; paste the PEM Sapiex sent you.
LICENSE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# On-prem backups (docker-compose.onprem.yml mounts this read-only into postgres)
# -----------------------------------------------------------------------------
BACKUP_HOST_PATH=./backups

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host port docker-compose.yml's app service publishes on — change if 3000
# is already taken on this machine. Keep in sync with NEXT_PUBLIC_APP_URL above.
APP_PORT=3000
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# Set to "1" to skip env validation (e.g., Docker build without secrets)
SKIP_ENV_VALIDATION=
