  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  riskRegisterId String       @db.Uuid
  riskRegister   RiskRegister @relation(fields: [riskRegisterId], references: [id], onDelete: Cascade)

  name          String
  description   String?  @db.Text
  currentValue  Decimal? @db.Decimal(15, 4)
  thresholdLow  Decimal? @db.Decimal(15, 4)
  thresholdHigh Decimal? @db.Decimal(15, 4)
  breachStatus  String   @default("NORMAL") // "NORMAL", "WARNING", "BREACH"
  frequency     String   @default("MONTHLY") // "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY"
  lastUpdated   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([riskRegisterId])
  @@index([breachStatus])
}

// ─── M8: Risk-to-Audit Linkage (R52) ────────────────────────────────────────

model RiskAuditLinkage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
