// ─── M8: Risk Register (R50) ─────────────────────────────────────────────────

model RiskRegister {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entityId       String              @db.Uuid
  entity         AuditUniverseEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  riskStatement   String  @db.Text
  riskCategory    String  // "CREDIT", "OPERATIONAL", "MARKET", "LIQUIDITY", "COMPLIANCE", "IT"
  inherentScore   Decimal @db.Decimal(5, 2)
  controlScore    Decimal @db.Decimal(5, 2)
  residualScore   Decimal @db.Decimal(5, 2)
  riskOwner       String?
  mitigationPlan  String? @db.Text
  status          String  @default("OPEN") // "OPEN", "MITIGATED", "ACCEPTED", "CLOSED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kris              KeyRiskIndicator[]
  riskAuditLinkages RiskAuditLinkage[]
  linkedControls    ControlLibrary[]

  @@index([tenantId])
  @@index([entityId])
  @@index([riskCategory])
}

// ─── M8: Key Risk Indicator (R51) ────────────────────────────────────────────

model KeyRiskIndicator {
