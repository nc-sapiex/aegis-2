// ─── M8: Audit Universe Entity (R49) ──────────────────────────────────────────

model AuditUniverseEntity {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entityType        String  // "BRANCH", "DEPARTMENT", "PROCESS", "CHANNEL", "VENDOR"
  name              String
  description       String?  @db.Text
  branchId          String?  @db.Uuid
  branch            Branch?  @relation(fields: [branchId], references: [id])
  riskScore         Decimal? @db.Decimal(5, 2)
  lastAuditDate     DateTime?
  lastAuditRating   String?
  requiredFrequency Int?     // months between audits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riskRegisters      RiskRegister[]
  riskAuditLinkages  RiskAuditLinkage[]

  @@unique([tenantId, entityType, name])
  @@index([tenantId])
  @@index([entityType])
