// ─── M12: Issue (R59-R60) ───────────────────────────────────────────────────

model Issue {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title           String
  description     String          @db.Text
  source          String          // "INTERNAL_AUDIT", "REGULATORY", "EXTERNAL_AUDIT", "SELF_ASSESSMENT", "CONCURRENT"
  issueType       String          // "FINDING", "OBSERVATION", "EXCEPTION", "DEFICIENCY"
