// ═══════════════════════════════════════════════════════════════════════════════
// v6.0: RBIA Redesign Models
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Examination Node (v6.0 — hierarchical examination framework) ──────────
// Replaces ExaminationArea + ExaminationItem with variable-depth tree.
// Leaf nodes (isLeaf=true) are value statements that get scored.
// Non-leaf nodes are groupings whose scores are computed via weighted child roll-up.

model ExaminationNode {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code     String   // e.g., "OPS", "OPS-KYC", "OPS-KYC-001"
  name     String   // Display name e.g., "KYC/AML Compliance"
  path     String   // Materialized path e.g., "OPS/OPS-KYC/OPS-KYC-001"
  depth    Int      // 0=root area, 1=module, 2=sub-module, 3+=leaf items
  isLeaf   Boolean  @default(false)

  parentId String?          @db.Uuid
  parent   ExaminationNode? @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ExaminationNode[] @relation("NodeHierarchy")

  weight      Decimal  @db.Decimal(5, 4) @default(1.0) // Weight within parent group
  isCritical  Boolean  @default(false) // Critical item override: if NON_COMPLIANT, caps parent score

  riskCategory        String?  // e.g., "Operational Risk", "Credit Risk"
  regulatoryRef       String?  // RBI circular reference
  applicableBranchTypes String[] // e.g., ["LARGE", "MEDIUM", "SMALL"] — empty = all
  description         String?  @db.Text // Value statement text for leaf nodes

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  responses            ExaminationResponse[]
  moduleSelections     EngagementModuleSelection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, path])
  @@index([parentId])
  @@index([tenantId, depth, isActive])
}

// ─── Examination Response (v6.0 — per-item audit response with 4-point scoring) ─

model ExaminationResponse {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid

  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  nodeId String          @db.Uuid
  node   ExaminationNode @relation(fields: [nodeId], references: [id])

  // 4-point scoring: 1.0 (Fully), 0.75 (Largely), 0.5 (Partially), 0.0 (Non-Compliant), NULL (not yet scored)
  score      Decimal?   @db.Decimal(4, 2)
  scoreLabel ScoreLabel?

  // Explicit N/A. A null score means "not yet examined"; this means "examined
  // and does not apply to this branch". The freeze gate distinguishes them.
  isNotApplicable      Boolean @default(false)
  notApplicableReason  String? @db.Text

  workingNotes       String?  @db.Text  // Auditor's detailed notes
  flagForObservation Boolean  @default(false) // Flag for promotion to formal 5C Observation
  flagForActionPoint Boolean  @default(false) // Flag for promotion to Action Point

  respondedById String?  @db.Uuid
  respondedAt   DateTime?

  // Evidence
  evidence Evidence[] @relation("ExaminationResponseEvidence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to findings
  actionPoints ActionPoint[]

  @@unique([engagementId, nodeId])
  @@index([tenantId])
  @@index([engagementId])
  @@index([engagementId, flagForObservation])
  @@index([engagementId, flagForActionPoint])
}

// ─── Branch RBIA Score (v6.0 — frozen score snapshot per engagement) ─────────

model BranchRbiaScore {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid

  engagementId String @unique @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  branchId String @db.Uuid

  compositeScore Decimal  @db.Decimal(5, 2) // 0.00 - 1.00
  ratingBand     String   // "VERY_GOOD", "GOOD", "SATISFACTORY", "MODERATE", "POOR"

  // JSONB snapshots — authoritative historical record
  moduleScores       Json // { "OPS": 0.85, "CREDIT": 0.72, ... }
  scoringTreeSnapshot Json // Full tree with per-node scores for drill-down

  frozenAt   DateTime? // NULL = live/draft, non-NULL = frozen (immutable)
  frozenById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, frozenAt])
}

// ─── Engagement Module Selection (v6.0 — dynamic module selection per engagement) ─

model EngagementModuleSelection {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid

  engagementId   String          @db.Uuid
  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  moduleNodeId   String          @db.Uuid
  moduleNode     ExaminationNode @relation(fields: [moduleNodeId], references: [id])

  isAutoSelected  Boolean @default(false)
  selectionReason String?  // e.g., "Branch type: LARGE", "Manual addition by Lead Auditor"
  removalReason   String? @db.Text  // Documented reason for manual removal (ENGG-06 audit trail)

  createdAt DateTime @default(now())

  @@unique([engagementId, moduleNodeId])
  @@index([tenantId])
  @@index([engagementId])
}

// ─── Engagement Meeting (v6.0 — opening/exit meeting records) ───────────────

model EngagementMeeting {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid

  engagementId   String      @db.Uuid
  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  meetingType    MeetingType
  meetingDate    DateTime
  attendees      Json         // [{ name, role, designation }]
  minutesText    String?      @db.Text
  keyDiscussionPoints String? @db.Text
  signedOff      Boolean      @default(false)
  signedOffById  String?      @db.Uuid
  signedOffAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engagementId, meetingType])
  @@index([tenantId])
}

// ─── Action Point (v6.0 — operational findings with simple lifecycle) ────────

model ActionPoint {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid

  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  branchId     String          @db.Uuid

  serialNo     Int             // Sequential within engagement: AP-001, AP-002
  title        String
  description  String          @db.Text
  severity     Severity
  moduleCode   String          // ExaminationNode code for traceability

  // Source traceability
  sourceResponseId String?             @db.Uuid
  sourceResponse   ExaminationResponse? @relation(fields: [sourceResponseId], references: [id])

  status ActionPointStatus @default(DRAFT)

  // Branch Manager response
  bmResponseText     String?   @db.Text
  bmResponseDate     DateTime?
  bmResponseDeadline DateTime? // 15 days from report issuance

  // Verification & closure
  verifiedById String?   @db.Uuid
  verifiedAt   DateTime?
  closedById   String?   @db.Uuid
  closedAt     DateTime?

  // Carry-forward linkage
  carriedForwardToEngagementId String? @db.Uuid

  // v6.0: Evidence attachments from BM responses
  evidence        Evidence[]    @relation("ActionPointEvidence")

  createdById String @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([engagementId])
  @@index([engagementId, status])
  @@index([branchId, status])
}

// ─── BM Response Batch (v6.0 — branch manager batch response tracking) ──────

model BmResponseBatch {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid

  engagementId   String @unique @db.Uuid
  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  totalActionPoints    Int
  respondedActionPoints Int @default(0)
  deadline             DateTime  // 15 days from report issuance
  status               BmBatchStatus @default(PENDING)
  submittedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status, deadline])
}

// ─── Positive Observation (v6.0 — commendable practices per engagement) ─────

model PositiveObservation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  engagementId   String          @db.Uuid
  engagement     AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  title          String
  description    String @db.Text
  moduleCode     String // ExaminationNode code

  createdById    String @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([engagementId])
}

// ─── v7.0 Examination Question (account-level question library per credit module) ──

model ExaminationQuestion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  moduleCode      String   // ExaminationNode code (e.g., "CRD-HLN") — decoupled linkage
  text            String   @db.Text // Question text
  rbiReference    String?  // RBI regulation area (e.g., "Master Direction on Housing Finance")
  bestPracticeTip String?  @db.Text // 1-2 sentence practical guidance
  category        String?  // Grouping within module (e.g., "Documentation", "Collateral", "NPA Norms")

  weight     Decimal @default(1.0) @db.Decimal(5, 4) // Weight for scoring
  isCritical Boolean @default(false) // Critical item: violation caps module score

  displayOrder Int     @default(0) // For management UI ordering
  isActive     Boolean @default(true) // Soft-delete: false hides from new examinations

  createdById String?  @db.Uuid // NULL for system-seeded defaults
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  accountExamResponses AccountExamResponse[]

  @@unique([tenantId, moduleCode, text])
  @@index([tenantId])
  @@index([tenantId, moduleCode, isActive])
  @@index([tenantId, moduleCode, displayOrder])
}

// ─── v7.0 Loan Account (uploaded branch loan portfolio for sample-based examination) ──

model LoanAccount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  branchId   String @db.Uuid
  moduleCode String // Credit module code (e.g., "CRD-HLN")

  // Core mandatory fields
  accountNo         String
  borrowerName      String
  productType       String  // "Housing Loan", "Gold Loan", "Vehicle Loan", etc.
  sanctionAmount    Decimal @db.Decimal(15, 2)
  sanctionDate      DateTime // For "newly sanctioned" sampling criteria
  outstandingAmount Decimal @db.Decimal(15, 2)
  assetClass        String  // "STANDARD", "SMA0", "SMA1", "SMA2", "NPA_SUB", "NPA_DOUBTFUL", "NPA_LOSS"
  dpd               Int     @default(0) // Days Past Due

  // JSONB for module-specific fields
  metadata Json? // Flexible per-module fields

  // Sampling state
  isSampled Boolean   @default(false)
  sampledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accountExamResponses AccountExamResponse[]

  @@unique([engagementId, accountNo])
  @@index([tenantId])
  @@index([engagementId])
  @@index([engagementId, moduleCode])
  @@index([engagementId, isSampled])
  @@index([engagementId, assetClass])
  @@index([engagementId, dpd])
}

// ─── v7.0 Sampling Config (HIA-defined sampling criteria per engagement/module) ──

model SamplingConfig {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  moduleCode    String  // Credit module code (e.g., "CRD-HLN")
  sampleSizePct Decimal @db.Decimal(5, 2) // Overall sample size % (e.g., 10.00)

  // Criteria bucket allocations — JSONB array of { bucket, pct, description }
  criteriaBuckets Json // Array of bucket allocations, must sum to 100

  isLocked   Boolean   @default(false) // Once locked, auditors cannot modify
  lockedAt   DateTime?
  lockedById String?   @db.Uuid

  // Snapshot of generated sample metadata
  sampleGenerated   Boolean   @default(false)
  sampleGeneratedAt DateTime?
  sampleCount       Int? // Number of accounts selected

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([engagementId, moduleCode])
  @@index([tenantId])
  @@index([engagementId])
}

// ─── v7.0 Account Exam Response (per-account per-question examination response) ──

model AccountExamResponse {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid

  engagementId String          @db.Uuid
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  loanAccountId String      @db.Uuid
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)

  questionId String              @db.Uuid
  question   ExaminationQuestion @relation(fields: [questionId], references: [id])

  status AccountExamResponseStatus // COMPLIANT or VIOLATION
  note   String?                   @db.Text // Auditor's finding notes

  // Audit trail
  respondedById String   @db.Uuid
  respondedAt   DateTime @default(now())

  // Evidence
  evidence Evidence[] @relation("AccountExamResponseEvidence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engagementId, loanAccountId, questionId])
  @@index([tenantId])
  @@index([engagementId])
  @@index([engagementId, questionId])
  @@index([loanAccountId])
}

// ─── Failed Login Attempt Tracking (Phase 11 — account lockout) ─────────────

model FailedLoginAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    // Track by email, not userId (pre-auth, user may not exist)
  ipAddress   String
  attemptedAt DateTime  @default(now())
  lockedUntil DateTime? // NULL = not locked; non-NULL = account locked until this time

  @@index([email, attemptedAt])
  @@index([email, lockedUntil])
}
